# Optional environment variables for Glyph (Build Term for Grok)
# Copy to .env and adjust (never commit .env).
# Loaded by npm start / npm run dev / LaunchAgent via Node --env-file-if-exists.

# Bridge / production port model
# Prod (npm start, LaunchAgent): UI + API + WS on one port
# PORT=5174
# HOST=127.0.0.1
# Dev: Vite UI on 5173 proxies /api and /ws → 5174

# Workspace for new ACP sessions
# GLYPH_UI_CWD=/path/to/your/project

# Grok CLI
# GROK_BIN=grok
# GROK_HOME=~/.grok

# UI state & wiki archive
# GLYPH_UI_STATE_DIR=~/.glyph-ui
# Default wiki archive: ~/.glyph-ui/wiki
# Point at an Obsidian vault (or any folder) if you want archives there instead:
# WIKI_PATH=~/ObsidianVaults/memory-wiki
# OPENCLAW_WIKI_PATH=~/path/to/your/vault  # alias if WIKI_PATH unset

# Attachments
# GLYPH_UI_MAX_ATTACHMENT=12582912

# Security (default: loopback only)
# GLYPH_ALLOW_REMOTE=1
# Public web surface (glyph-ui.com): password gate
# GLYPH_WEB_PASSWORD=
# GLYPH_WEB_HOSTS=glyph-ui.com,www.glyph-ui.com

# HSEQ-Sync-Auslöser: Obsidian-Vault, dessen Trigger-Notiz der Server beobachtet.
# Der Knopf „Jetzt verarbeiten“ am Arbeits-PC schreibt nur diese Notiz; Obsidian
# Sync bringt sie zum Mac, der Server startet den recurring-Job. Leer = aus.
# Alternativ direkt die Datei setzen: GLYPH_HSEQ_TRIGGER_FILE=/pfad/_hseq-trigger.md
# GLYPH_HSEQ_VAULT=~/ObsidianVaults/HSEQ Sync
# GLYPH_HSEQ_POLL_MS=5000

# Voice (STT/TTS) — https://console.x.ai
# XAI_API_KEY=xai-...
# GROK_TTS_VOICE=eve
# GROK_STT_LANGUAGE=de
# GROK_TTS_LANGUAGE=de

# OpenRouter (^_tick / °_Agent Cloud-Antwort) — https://openrouter.ai
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
# OPENROUTER_URL=https://openrouter.ai/api/v1
#
# Keys können auch in der UI unter Buch → Anbindung gesetzt werden:
#   ~/.glyph-ui/bindings.json  (lokal, nicht committen)
# Env-Variablen hier haben Vorrang, wenn sie beim Start bereits gesetzt sind.
# GLYPH_AGENT_URL=http://127.0.0.1:18899

# Lokales Modell (27B Bonsai) — Lebensdauer & Speicher-Bremse
# Standard-Startbefehl: ~/.local/bonsai2/bonsai-server (setzt --metrics).
# GLYPH_LOCAL_MODEL_CMD=/pfad/zu/bonsai-server
# GLYPH_LOCAL_URL=http://127.0.0.1:8080/v1
# LOCAL_MODEL=bonsai-2-27b-uncensored
# Schlafen nach Leerlauf (nur mit /metrics), harte Laufzeit, Start-Cooldown:
# GLYPH_LOCAL_IDLE_MS=1200000       # 20 min
# GLYPH_LOCAL_MAX_RUNTIME_MS=10800000  # 3 h
# GLYPH_LOCAL_COOLDOWN_MS=30000
# GLYPH_LOCAL_START_TIMEOUT_MS=120000
# GLYPH_LOCAL_TICK_MS=15000
# Speicher-Bremse: unter X MB verfügbar (frei+inaktiv+spekulativ+purgeable)
# wird das Modell schlafen gelegt. 0 = aus.
# GLYPH_LOCAL_MIN_FREE_MB=1200
# GLYPH_LOCAL_MEM_QUIET_MS=90000
